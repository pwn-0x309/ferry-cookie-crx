{
  "id": "F3",
  "description": "CHIPS-partitioned cookie is excluded from the JSON and counted in the report",
  "input": {
    "sourceOrigin": "https://app.example.com",
    "targetOrigin": "http://localhost",
    "cookies": [
      {
        "domain": "app.example.com",
        "expirationDate": 1810000000.5,
        "hostOnly": true,
        "httpOnly": true,
        "name": "sid",
        "path": "/",
        "sameSite": "lax",
        "secure": true,
        "session": false,
        "storeId": "0",
        "value": "normal-session"
      },
      {
        "domain": "app.example.com",
        "hostOnly": true,
        "httpOnly": false,
        "name": "chips",
        "partitionKey": {
          "topLevelSite": "https://other.example",
          "hasCrossSiteAncestor": false
        },
        "path": "/",
        "sameSite": "lax",
        "secure": true,
        "session": true,
        "storeId": "0",
        "value": "partitioned-value"
      }
    ],
    "protectedNames": []
  },
  "expected": {
    "cookies": [
      {
        "domain": "localhost",
        "expirationDate": 1810000000.5,
        "hostOnly": true,
        "httpOnly": true,
        "name": "sid",
        "path": "/",
        "sameSite": "lax",
        "secure": true,
        "session": false,
        "storeId": "0",
        "value": "normal-session"
      }
    ],
    "report": {
      "sourceHost": "app.example.com",
      "targetHost": "localhost",
      "emitted": 1,
      "duplicatesCollapsed": 0,
      "partitionedExcluded": 1,
      "brokenPairNames": [],
      "hostPrefixCoercedNames": [],
      "protectedNames": []
    }
  }
}
